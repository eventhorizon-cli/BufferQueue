---
config:
  flowchart:
    htmlLabels: true
    curve: linear
    nodeSpacing: 55
    rankSpacing: 70
    padding: 18
  theme: base
  themeVariables:
    fontFamily: "Arial, PingFang SC, Microsoft YaHei, sans-serif"
    fontSize: 18px
    primaryTextColor: "#303b44"
    lineColor: "#475467"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f8fafc"
    clusterBorder: "#d0d5dd"
---
flowchart LR
    P[Producer 追加数据] --> Q[Partition 中已有排队数据]
    Q -. 唤醒提示 .-> W[等待 pending-data 通知]
    W -. 通知 .-> D{尝试拉取下一批<br/>有数据？}
    S[扫描已分配 Partition<br/>round-robin] --> D
    D -- 是 --> B[机会式批量消费<br/>最多 BatchSize 条已排队数据]
    B --> S
    D -- 否 --> W

    class P client
    class Q router
    class S,D core
    class W wait
    class B handler
    classDef client fill:#e9f6f1,stroke:#2f6f5e,color:#303b44,stroke-width:1.5px
    classDef router fill:#eaf2ff,stroke:#3567a7,color:#303b44,stroke-width:1.5px
    classDef core fill:#edf1f5,stroke:#596773,color:#303b44,stroke-width:1.5px
    classDef wait fill:#eaf2ff,stroke:#3567a7,color:#303b44,stroke-width:1.5px
    classDef handler fill:#f4edfb,stroke:#75529b,color:#303b44,stroke-width:1.5px
