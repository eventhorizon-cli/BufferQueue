---
config:
  flowchart:
    htmlLabels: true
    curve: linear
    nodeSpacing: 55
    rankSpacing: 70
    padding: 18
  theme: base
  themeVariables:
    fontFamily: "Arial, PingFang SC, Microsoft YaHei, sans-serif"
    fontSize: 18px
    primaryTextColor: "#303b44"
    lineColor: "#475467"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f8fafc"
    clusterBorder: "#d0d5dd"
---
flowchart LR
    P[Producer appends data] --> Q[Partition has queued data]
    Q -. wake-up hint .-> W[Wait for pending-data notification]
    W -. notification .-> D{Try pulling the next batch<br/>Data available?}
    S[Scan assigned partitions<br/>round-robin] --> D
    D -- Yes --> B[Opportunistic batch<br/>up to BatchSize queued items]
    B --> S
    D -- No --> W

    class P client
    class Q router
    class S,D core
    class W wait
    class B handler
    classDef client fill:#e9f6f1,stroke:#2f6f5e,color:#303b44,stroke-width:1.5px
    classDef router fill:#eaf2ff,stroke:#3567a7,color:#303b44,stroke-width:1.5px
    classDef core fill:#edf1f5,stroke:#596773,color:#303b44,stroke-width:1.5px
    classDef wait fill:#eaf2ff,stroke:#3567a7,color:#303b44,stroke-width:1.5px
    classDef handler fill:#f4edfb,stroke:#75529b,color:#303b44,stroke-width:1.5px
