---
config:
  flowchart:
    htmlLabels: true
    curve: linear
    nodeSpacing: 55
    rankSpacing: 70
    padding: 18
  theme: base
  themeVariables:
    fontFamily: "Arial, PingFang SC, Microsoft YaHei, sans-serif"
    fontSize: 18px
    primaryTextColor: "#172b4d"
    lineColor: "#475467"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f8fafc"
    clusterBorder: "#d0d5dd"
---
flowchart LR
    P[Producer appends data] --> Q[Partition has queued data]
    Q -. wake-up hint .-> W[Wait for pending-data notification]
    W -. notification .-> D{Try pulling the next batch<br/>Data available?}
    S[Scan assigned partitions<br/>round-robin] --> D
    D -- Yes --> B[Opportunistic batch<br/>up to BatchSize queued items]
    B --> S
    D -- No --> W

    class P client
    class Q router
    class S,D core
    class W wait
    class B handler
    classDef client fill:#eff7f2,stroke:#7cae9a,color:#172b4d,stroke-width:1.5px
    classDef router fill:#eff4fb,stroke:#7c9fc9,color:#172b4d,stroke-width:1.5px
    classDef core fill:#f8fafc,stroke:#a6b1c0,color:#172b4d,stroke-width:1.5px
    classDef wait fill:#eff4fb,stroke:#7c9fc9,color:#172b4d,stroke-width:1.5px
    classDef handler fill:#f5f0fa,stroke:#b29bcc,color:#172b4d,stroke-width:1.5px
